<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>System - FlexExt EAA Accessibility Guard</name>
    <author>Visacom / FlexExt</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Visacom / FlexExt. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>contact@flexext.dev</authorEmail>
    <authorUrl>https://flexext.dev</authorUrl>
    <version>1.0.1</version>
    <description>PLG_SYSTEM_EAAGUARD_FREE_XML_DESC</description>
    <namespace path="src">Visacom\Plugin\System\EaaguardFree</namespace>

    <files>
        <folder plugin="eaaguard_free">services</folder>
        <folder>src</folder>
        <folder>field</folder>
        <folder>media</folder>
        <folder>language</folder>
        <filename>LICENSE.txt</filename>
        <filename>README.md</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_eaaguard_free.ini</language>
        <language tag="en-GB">en-GB/plg_system_eaaguard_free.sys.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_eaaguard_free.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_eaaguard_free.sys.ini</language>
    </languages>

    <updateservers>
        <server type="extension" priority="1" name="System - FlexExt EAA Accessibility Guard Updates">https://flexext.dev/updates/plg_system_eaaguard_free.xml</server>
    </updateservers>

    <config>
        <fields name="params" addfieldpath="/plugins/system/eaaguard_free/field">
            <fieldset name="dashboard" label="PLG_SYSTEM_EAAGUARD_FREE_TAB_DASHBOARD">
                <field
                    name="dashboard_view"
                    type="eaaguardfreedashboard"
                    label=""
                    hiddenLabel="true"
                />
            </fieldset>

            <fieldset name="basic" label="PLG_SYSTEM_EAAGUARD_FREE_TAB_SETTINGS">
                <field
                    name="frontend_badge"
                    type="radio"
                    label="PLG_SYSTEM_EAAGUARD_FREE_FRONTEND_BADGE"
                    description="PLG_SYSTEM_EAAGUARD_FREE_FRONTEND_BADGE_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="badge_position"
                    type="list"
                    label="PLG_SYSTEM_EAAGUARD_FREE_BADGE_POSITION"
                    description="PLG_SYSTEM_EAAGUARD_FREE_BADGE_POSITION_DESC"
                    default="bottom-right"
                >
                    <option value="bottom-right">PLG_SYSTEM_EAAGUARD_FREE_POS_BOTTOM_RIGHT</option>
                    <option value="bottom-left">PLG_SYSTEM_EAAGUARD_FREE_POS_BOTTOM_LEFT</option>
                </field>
            </fieldset>

            <fieldset name="declaration" label="PLG_SYSTEM_EAAGUARD_FREE_TAB_DECLARATION">
                <field
                    name="org_name"
                    type="text"
                    label="PLG_SYSTEM_EAAGUARD_FREE_ORG_NAME"
                    description="PLG_SYSTEM_EAAGUARD_FREE_ORG_NAME_DESC"
                    default="Instytucja / Przedsiębiorstwo"
                />
                <field
                    name="site_url"
                    type="text"
                    label="PLG_SYSTEM_EAAGUARD_FREE_SITE_URL"
                    description="PLG_SYSTEM_EAAGUARD_FREE_SITE_URL_DESC"
                    default=""
                />
                <field
                    name="pub_date"
                    type="text"
                    label="PLG_SYSTEM_EAAGUARD_FREE_PUB_DATE"
                    description="PLG_SYSTEM_EAAGUARD_FREE_PUB_DATE_DESC"
                    default="2026-01-01"
                />
                <field
                    name="update_date"
                    type="text"
                    label="PLG_SYSTEM_EAAGUARD_FREE_UPDATE_DATE"
                    description="PLG_SYSTEM_EAAGUARD_FREE_UPDATE_DATE_DESC"
                    default="2026-10-22"
                />
                <field
                    name="compliance_status"
                    type="list"
                    label="PLG_SYSTEM_EAAGUARD_FREE_COMPLIANCE_STATUS"
                    description="PLG_SYSTEM_EAAGUARD_FREE_COMPLIANCE_STATUS_DESC"
                    default="partial"
                >
                    <option value="full">PLG_SYSTEM_EAAGUARD_FREE_STATUS_FULL</option>
                    <option value="partial">PLG_SYSTEM_EAAGUARD_FREE_STATUS_PARTIAL</option>
                    <option value="none">PLG_SYSTEM_EAAGUARD_FREE_STATUS_NONE</option>
                </field>
                <field
                    name="contact_person"
                    type="text"
                    label="PLG_SYSTEM_EAAGUARD_FREE_CONTACT_PERSON"
                    default="Koordynator ds. Dostępności Cyfrowej"
                />
                <field
                    name="contact_email"
                    type="email"
                    label="PLG_SYSTEM_EAAGUARD_FREE_CONTACT_EMAIL"
                    default="dostepnosc@example.com"
                />
                <field
                    name="contact_phone"
                    type="tel"
                    label="PLG_SYSTEM_EAAGUARD_FREE_CONTACT_PHONE"
                    default="+48 22 000 00 00"
                />
                <field
                    name="unaccessible_desc"
                    type="textarea"
                    label="PLG_SYSTEM_EAAGUARD_FREE_UNACCESSIBLE_DESC"
                    rows="4"
                    default="Niektóre starsze dokumenty PDF opublikowane przed wejściem w życie przepisów EAA mogą nie zawierać pełnej struktury znaczników Tagged PDF. Sukcesywnie wdrażana jest ich konwersja."
                />
                <field
                    name="arch_desc"
                    type="textarea"
                    label="PLG_SYSTEM_EAAGUARD_FREE_ARCH_DESC"
                    description="PLG_SYSTEM_EAAGUARD_FREE_ARCH_DESC_DESC"
                    rows="4"
                    default="Budynek wyposażony jest w podjazd dla wózków inwalidzkich, windę z komunikatami głosowymi oraz oznaczenia w alfabecie Braille'a. Do budynku można wejść z psem asystującym."
                />
            </fieldset>
        </fields>
    </config>
</extension>
