<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>System - FlexExt AI SEO Readiness</name>
    <author>Visacom / FlexExt</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Visacom / FlexExt. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>contact@flexext.dev</authorEmail>
    <authorUrl>https://flexext.dev</authorUrl>
    <version>1.0.2</version>
    <description>PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_XML_DESC</description>
    <namespace path="src">Visacom\Plugin\System\FlexextAiSeoFree</namespace>

    <files>
        <folder plugin="flexext_ai_seo_free">services</folder>
        <folder>src</folder>
        <folder>field</folder>
        <folder>language</folder>
        <filename>LICENSE.txt</filename>
        <filename>README.md</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_flexext_ai_seo_free.ini</language>
        <language tag="en-GB">en-GB/plg_system_flexext_ai_seo_free.sys.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_flexext_ai_seo_free.ini</language>
        <language tag="pl-PL">pl-PL/plg_system_flexext_ai_seo_free.sys.ini</language>
    </languages>

    <updateservers>
        <server type="extension" priority="1" name="System - FlexExt AI SEO Readiness Updates">https://flexext.dev/updates/plg_system_flexext_ai_seo_free.xml</server>
    </updateservers>

    <config>
        <fields name="params" addfieldpath="/plugins/system/flexext_ai_seo_free/field">
            <fieldset name="dashboard" label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_TAB_DASHBOARD">
                <field
                    name="dashboard_view"
                    type="aiseofreedashboard"
                    label=""
                    hiddenLabel="true"
                />
            </fieldset>

            <fieldset name="llmstxt" label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_TAB_LLMSTXT">
                <field
                    name="enable_llms_txt"
                    type="radio"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ENABLE_LLMS_TXT"
                    description="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ENABLE_LLMS_TXT_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="site_summary"
                    type="textarea"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_SITE_SUMMARY"
                    description="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_SITE_SUMMARY_DESC"
                    rows="3"
                    default="Official website providing comprehensive information, high-quality products, and professional services."
                />

                <field
                    name="contact_url"
                    type="text"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_CONTACT_URL"
                    description="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_CONTACT_URL_DESC"
                    default="/contact"
                />
            </fieldset>

            <fieldset name="botshield" label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_TAB_BOTSHIELD">
                <field
                    name="enable_bot_shield"
                    type="radio"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ENABLE_BOT_SHIELD"
                    description="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ENABLE_BOT_SHIELD_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="gptbot_action"
                    type="list"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_GPTBOT"
                    default="allow"
                >
                    <option value="allow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ALLOW</option>
                    <option value="disallow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_DISALLOW</option>
                </field>

                <field
                    name="claudebot_action"
                    type="list"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_CLAUDEBOT"
                    default="allow"
                >
                    <option value="allow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ALLOW</option>
                    <option value="disallow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_DISALLOW</option>
                </field>

                <field
                    name="perplexity_action"
                    type="list"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_PERPLEXITY"
                    default="allow"
                >
                    <option value="allow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ALLOW</option>
                    <option value="disallow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_DISALLOW</option>
                </field>

                <field
                    name="ccbot_action"
                    type="list"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_CCBOT"
                    default="disallow"
                >
                    <option value="allow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ALLOW</option>
                    <option value="disallow">PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_DISALLOW</option>
                </field>
            </fieldset>

            <fieldset name="schema" label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_TAB_SCHEMA">
                <field
                    name="enable_schema_org"
                    type="radio"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ENABLE_SCHEMA"
                    description="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ENABLE_SCHEMA_DESC"
                    layout="joomla.form.field.radio.switcher"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="org_name"
                    type="text"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ORG_NAME"
                    default=""
                />

                <field
                    name="org_type"
                    type="list"
                    label="PLG_SYSTEM_FLEXEXT_AI_SEO_FREE_ORG_TYPE"
                    default="Organization"
                >
                    <option value="Organization">Organization</option>
                    <option value="Corporation">Corporation</option>
                    <option value="LocalBusiness">LocalBusiness</option>
                    <option value="Store">Store</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
