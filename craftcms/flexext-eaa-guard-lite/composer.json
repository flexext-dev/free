{
  "name": "flexext/flexext-eaa-guard-lite",
  "description": "Free WCAG 2.2 AA & European Accessibility Act (EAA) entry alt/heading scanner and /accessibility-statement generator for Craft CMS 4 & 5.",
  "type": "craft-plugin",
  "version": "1.0.1",
  "keywords": [
    "craftcms",
    "accessibility",
    "wcag",
    "eaa",
    "a11y",
    "compliance",
    "bfsg"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "FlexExt",
      "homepage": "https://flexext.dev",
      "email": "contact@flexext.dev"
    }
  ],
  "support": {
    "email": "contact@flexext.dev",
    "issues": "https://github.com/flexext-dev/flexext-eaa-guard-lite/issues",
    "source": "https://github.com/flexext-dev/flexext-eaa-guard-lite",
    "docs": "https://github.com/flexext-dev/flexext-eaa-guard-lite/blob/main/README.md"
  },
  "require": {
    "php": "^8.1",
    "craftcms/cms": "^4.5.0 || ^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "flexext\\eaaguardlite\\": "src/"
    }
  },
  "extra": {
    "name": "FlexExt EAA & WCAG Guard Lite",
    "handle": "flexext-eaa-guard-lite",
    "developer": "FlexExt",
    "developerUrl": "https://flexext.dev",
    "documentationUrl": "https://github.com/flexext-dev/flexext-eaa-guard-lite/blob/main/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/flexext-dev/flexext-eaa-guard-lite/main/CHANGELOG.md",
    "class": "flexext\\eaaguardlite\\Plugin",
    "hasCpSettings": true,
    "hasCpSection": true
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
