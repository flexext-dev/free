{% extends "_layouts/cp" %}
{% set title = "FlexExt EAA & WCAG Guard Lite" %}

{% block content %}
<style>
  :root {
    --flx-bg: #f8fafc;
    --flx-card: #ffffff;
    --flx-text: #0f172a;
    --flx-muted: #334155;
    --flx-border: #cbd5e1;
    --flx-accent: #0369a1;
    --flx-accent-text: #ffffff;
    --flx-ok-bg: #dcfce7;
    --flx-ok-text: #14532d;
    --flx-warn-bg: #fef3c7;
    --flx-warn-text: #78350f;
    --flx-pro-bg: #eff6ff;
    --flx-pro-text: #1e3a8a;
  }
  body.dark, [data-bs-theme="dark"] {
    --flx-bg: #0f172a;
    --flx-card: #1e293b;
    --flx-text: #f8fafc;
    --flx-muted: #cbd5e1;
    --flx-border: #334155;
    --flx-accent: #38bdf8;
    --flx-accent-text: #082f49;
    --flx-ok-bg: #052e16;
    --flx-ok-text: #bbf7d0;
    --flx-warn-bg: #451a03;
    --flx-warn-text: #fde68a;
    --flx-pro-bg: #172554;
    --flx-pro-text: #dbeafe;
  }
  @media (prefers-color-scheme: dark) {
    body.system {
      --flx-bg: #0f172a;
      --flx-card: #1e293b;
      --flx-text: #f8fafc;
      --flx-muted: #cbd5e1;
      --flx-border: #334155;
      --flx-accent: #38bdf8;
      --flx-accent-text: #082f49;
      --flx-ok-bg: #052e16;
      --flx-ok-text: #bbf7d0;
      --flx-warn-bg: #451a03;
      --flx-warn-text: #fde68a;
      --flx-pro-bg: #172554;
      --flx-pro-text: #dbeafe;
    }
  }
  .flx-box { background: var(--flx-card); color: var(--flx-text); border: 1px solid var(--flx-border); border-radius: 10px; padding: 20px; margin-bottom: 20px; }
  .flx-pro { background: var(--flx-pro-bg); color: var(--flx-pro-text); border: 1px solid var(--flx-border); border-radius: 10px; padding: 20px; }
  .flx-btn { display: inline-block; background: var(--flx-accent); color: var(--flx-accent-text) !important; text-decoration: none; padding: 9px 16px; border-radius: 7px; font-weight: 700; margin-right: 8px; }
  .flx-badge-ok { display: inline-block; background: var(--flx-ok-bg); color: var(--flx-ok-text); padding: 3px 9px; border-radius: 6px; font-weight: 700; font-size: 12px; }
  .flx-badge-warn { display: inline-block; background: var(--flx-warn-bg); color: var(--flx-warn-text); padding: 3px 9px; border-radius: 6px; font-weight: 700; font-size: 12px; }
  .flx-table { width: 100%; border-collapse: collapse; margin-top: 12px; }
  .flx-table th, .flx-table td { border-bottom: 1px solid var(--flx-border); padding: 10px 8px; text-align: left; color: var(--flx-text); }
</style>

<div class="flx-box">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <div>
      <span class="flx-badge-ok">MIT Open-Source Starter &bull; v{{ plugin.version }}</span>
      <h2 style="margin:8px 0 4px;color:var(--flx-text);">Entry HTML Accessibility Scan (Up to 25 Published Entries)</h2>
      <p style="margin:0;color:var(--flx-muted);">Public statement route: <a href="{{ baseUrl }}/accessibility-statement" target="_blank" rel="noopener">{{ baseUrl }}/accessibility-statement</a></p>
    </div>
    <div>
      <a class="flx-btn" href="{{ settingsUrl }}">Configure Settings</a>
    </div>
  </div>

  <table class="flx-table">
    <thead>
      <tr>
        <th>Entry</th>
        <th>Status</th>
        <th>Detected WCAG 2.2 Findings</th>
      </tr>
    </thead>
    <tbody>
      {% for row in scanRows %}
        <tr>
          <td><a href="{{ row.cpEditUrl }}">{{ row.title }}</a></td>
          <td>
            {% if row.issueCount == 0 %}
              <span class="flx-badge-ok">PASS</span>
            {% else %}
              <span class="flx-badge-warn">{{ row.issueCount }} issue(s)</span>
            {% endif %}
          </td>
          <td>
            {% if row.issueCount == 0 %}
              <span style="color:var(--flx-muted);">No missing alt attributes, empty links, or heading skips found.</span>
            {% else %}
              <ul style="margin:0;padding-left:18px;">
                {% for iss in row.issues %}
                  <li>{{ iss }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr><td colspan="3">No published entries found in this site handle yet.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="flx-pro">
  <h3 style="margin:0 0 8px;color:var(--flx-pro-text);">🛡️ Need Binary PDF/UA Asset Scanning, 1-Click Auto-Fix &amp; Strict Publish Gatekeeper?</h3>
  <p style="margin:0 0 12px;color:var(--flx-pro-text);">
    Upgrade to <strong>FlexExt EAA &amp; WCAG 2.2 Guard Pro</strong> to audit uploaded PDF files across Craft Volumes for <code>/StructTreeRoot</code> tags &amp; OCR text layers, enforce <code>EVENT_BEFORE_SAVE</code> editor guardrails, repair HTML accessibility issues in 1 click, and add an accessible storefront reader toolbar.
  </p>
  <a class="flx-btn" href="https://flexext.dev/en-gb/product/craft-cms-eaa-wcag-accessibility-guard-pro" target="_blank" rel="noopener">Get FlexExt EAA Guard Pro ↗</a>
  <a class="flx-btn" href="https://demo.flexext.dev/craft/" target="_blank" rel="noopener">Try Live Craft 5 Pro Demo ↗</a>
</div>
{% endblock %}
