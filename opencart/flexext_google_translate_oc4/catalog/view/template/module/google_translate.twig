.flx-gt-lang-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 6px 8px;
  border: 1px solid transparent;
  border-radius: 6px;
  background-color: transparent;
  color: #0f172a;
  text-align: left;
  cursor: pointer;
  transition: all 0.14s ease;
}
.flx-gt-lang-item:hover,
.flx-gt-lang-item:focus {
  background-color: #f1f5f9;
  color: #0284c7;
  border-color: #cbd5e1;
  outline: none;
}
.flx-gt-lang-item.active {
  background-color: #eff6ff;
  color: #1d4ed8;
  border-color: #93c5fd;
  font-weight: 700;
}
.flx-gt-lang-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1 1 auto;
  line-height: 1.2;
}
.flx-gt-lang-primary {
  font-size: 12.5px;
  font-weight: 600;
  color: inherit;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.flx-gt-lang-sub {
  font-size: 10.5px;
  color: #475569;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.flx-gt-lang-iso {
  font-size: 10px;
  font-weight: 700;
  color: #475569;
  background-color: #f1f5f9;
  padding: 1px 5px;
  border-radius: 3px;
  flex-shrink: 0;
}
.flx-gt-lang-item.active .flx-gt-lang-iso {
  background-color: #1d4ed8;
  color: #ffffff;
}

/* Dark Mode Overrides (WCAG AA Compliant) */
[data-bs-theme="dark"] .flx-gt-dropdown-menu,
.dark .flx-gt-dropdown-menu {
  background-color: #1e293b;
  color: #f8fafc;
  border-color: #334155;
}
[data-bs-theme="dark"] .flx-gt-menu-header,
.dark .flx-gt-menu-header {
  border-bottom-color: #334155;
  color: #cbd5e1;
}
[data-bs-theme="dark"] .flx-gt-search-input,
.dark .flx-gt-search-input {
  background-color: #0f172a;
  color: #f8fafc;
  border-color: #475569;
}
[data-bs-theme="dark"] .flx-gt-lang-item,
.dark .flx-gt-lang-item {
  color: #f8fafc;
}
[data-bs-theme="dark"] .flx-gt-lang-item:hover,
.dark .flx-gt-lang-item:hover {
  background-color: #334155;
  color: #38bdf8;
  border-color: #475569;
}
[data-bs-theme="dark"] .flx-gt-lang-item.active,
.dark .flx-gt-lang-item.active {
  background-color: #1e3a8a;
  color: #ffffff;
  border-color: #3b82f6;
}
[data-bs-theme="dark"] .flx-gt-lang-sub,
.dark .flx-gt-lang-sub {
  color: #cbd5e1;
}
[data-bs-theme="dark"] .flx-gt-lang-iso,
.dark .flx-gt-lang-iso {
  background-color: #0f172a;
  color: #cbd5e1;
}
</style>

<script type="text/javascript">
(function() {
  var wrapper = document.getElementById('flx-gt-wrapper');
  if (!wrapper) return;

  var sourceLang = wrapper.getAttribute('data-source-lang') || 'en';
  var posMode = wrapper.getAttribute('data-position') || 'top_bar_right';
  var autoRestore = wrapper.getAttribute('data-auto-restore') === '1';
  var gtScriptLoaded = false;
  var gtScriptReady = false;
  var pendingTargetLang = null;

  // Dynamic placement fallback if not already inside #top li.flx-gt-top-li
  if (!wrapper.closest('.flx-gt-top-li')) {
    var targetEl = null;
    if (posMode === 'top_bar_right') {
      targetEl = document.querySelector('#top .header-lang-currency') || document.querySelector('#top .float-end ul.list-inline') || document.querySelector('#top ul.list-inline');
      if (targetEl) {
        var li = document.createElement('li');
        li.className = 'list-inline-item flx-gt-top-li';
        li.appendChild(wrapper);
        targetEl.insertBefore(li, targetEl.firstChild);
      }
    } else if (posMode === 'top_bar_left') {
      targetEl = document.querySelector('#top .header-social') || document.querySelector('#top .float-start ul.list-inline') || document.querySelector('#top .container');
      if (targetEl) {
        targetEl.insertBefore(wrapper, targetEl.firstChild);
      }
    } else if (posMode === 'main_header') {
      targetEl = document.querySelector('header #cart') || document.querySelector('header .container .row');
      if (targetEl && targetEl.parentNode) {
        targetEl.parentNode.insertBefore(wrapper, targetEl);
      }
    } else if (posMode === 'custom_selector') {
      var customSel = wrapper.getAttribute('data-custom-selector');
      var customIns = wrapper.getAttribute('data-custom-insert') || 'prepend';
      if (customSel) {
        try {
          targetEl = document.querySelector(customSel);
          if (targetEl) {
            if (customIns === 'prepend') targetEl.insertBefore(wrapper, targetEl.firstChild);
            else if (customIns === 'append') targetEl.appendChild(wrapper);
            else if (customIns === 'before' && targetEl.parentNode) targetEl.parentNode.insertBefore(wrapper, targetEl);
            else if (customIns === 'after' && targetEl.parentNode) targetEl.parentNode.insertBefore(wrapper, targetEl.nextSibling);
          }
        } catch (e) {}
      }
    }
  }

  function getSavedGoogTransLang() {
    var match = document.cookie.match(/(?:^|;\s*)googtrans=([^;]+)/);
    if (!match || !match[1]) return sourceLang;
    var raw = decodeURIComponent(match[1]);
    var parts = raw.split('/');
    var lang = parts[parts.length - 1];
    return lang || sourceLang;
  }

  function setGoogTransCookie(targetLang) {
    var host = window.location.hostname;
    var rootDomain = host.replace(/^www\./i, '');
    if (!targetLang || targetLang === sourceLang) {
      var exp = 'expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
      document.cookie = 'googtrans=; ' + exp;
      document.cookie = 'googtrans=; ' + exp + '; domain=' + host;
      document.cookie = 'googtrans=; ' + exp + '; domain=.' + rootDomain;
    } else {
      var val = '/' + sourceLang + '/' + targetLang;
      var maxAge = 'max-age=2592000; path=/; SameSite=Lax';
      document.cookie = 'googtrans=' + val + '; ' + maxAge;
      if (host.indexOf('.') !== -1) {
        document.cookie = 'googtrans=' + val + '; ' + maxAge + '; domain=.' + rootDomain;
      }
    }
  }

  function updateSwitcherUI(langCode) {
    var items = wrapper.querySelectorAll('[data-lang-code]');
    var activeItem = null;
    for (var i = 0; i < items.length; i++) {
      if (items[i].getAttribute('data-lang-code') === langCode) {
        items[i].classList.add('active');
        activeItem = items[i];
      } else {
        items[i].classList.remove('active');
      }
    }
    if (!activeItem) return;

    var flagImg = document.getElementById('flx-gt-active-flag');
    var labelEl = document.getElementById('flx-gt-active-label');
    var iso = activeItem.getAttribute('data-lang-iso') || langCode.toUpperCase();
    var name = activeItem.getAttribute('data-lang-name') || iso;
    var flagSvg = activeItem.getAttribute('data-lang-flag');

    if (flagImg && flagSvg) {
      flagImg.src = flagSvg;
      flagImg.alt = iso;
      flagImg.classList.remove('d-none');
    }
    if (labelEl) {
      if (wrapper.classList.contains('flx-var-dropdown_flag_name')) {
        labelEl.textContent = name;
      } else if (wrapper.classList.contains('flx-var-dropdown_globe_text')) {
        labelEl.textContent = (langCode === sourceLang) ? ('Translate (' + iso + ')') : (name + ' (' + iso + ')');
      } else if (wrapper.classList.contains('flx-var-dropdown_flag_code')) {
        labelEl.textContent = iso;
      }
    }
  }

  function triggerGoogleCombo(targetLang) {
    var combo = document.querySelector('.goog-te-combo');
    if (combo) {
      if (targetLang === sourceLang) {
        combo.value = '';
        combo.dispatchEvent(new Event('change'));
        // Also check Google frame restore button if present
        setTimeout(function() {
          if (document.documentElement.classList.contains('translated-ltr') || document.documentElement.classList.contains('translated-rtl')) {
            window.location.reload();
          }
        }, 350);
      } else {
        combo.value = targetLang;
        combo.dispatchEvent(new Event('change'));
      }
      return true;
    }
    return false;
  }

  window.flxGoogleTranslateElementInit = function() {
    try {
      var included = [];
      var items = wrapper.querySelectorAll('[data-lang-code]');
      for (var i = 0; i < items.length; i++) {
        var c = items[i].getAttribute('data-lang-code');
        if (c && included.indexOf(c) === -1) included.push(c);
      }
      new google.translate.TranslateElement({
        pageLanguage: sourceLang,
        includedLanguages: included.join(','),
        autoDisplay: false
      }, 'google_translate_element');
      gtScriptReady = true;

      if (pendingTargetLang) {
        var target = pendingTargetLang;
        pendingTargetLang = null;
        var attempts = 0;
        var timer = setInterval(function() {
          attempts++;
          if (triggerGoogleCombo(target) || attempts > 25) {
            clearInterval(timer);
            var caret = document.getElementById('flx-gt-caret-icon');
            if (caret) caret.className = 'fa-solid fa-chevron-down flx-gt-caret';
          }
        }, 80);
      }
    } catch (e) {}
  };

  function ensureGoogleScriptLoaded() {
    if (gtScriptLoaded) return;
    gtScriptLoaded = true;
    var s = document.createElement('script');
    s.type = 'text/javascript';
    s.async = true;
    s.defer = true;
    s.src = 'https://translate.google.com/translate_a/element.js?cb=flxGoogleTranslateElementInit';
    document.head.appendChild(s);
  }

  window.flxToggleGtDropdown = function(btn, e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    var menu = document.getElementById('flx-gt-dropdown-menu');
    if (!menu) return;
    var isShown = menu.classList.contains('show');

    // Close other top bar dropdowns
    var openMenus = document.querySelectorAll('.dropdown-menu.show');
    for (var i = 0; i < openMenus.length; i++) openMenus[i].classList.remove('show');

    if (isShown) {
      menu.classList.remove('show');
      btn.setAttribute('aria-expanded', 'false');
    } else {
      menu.classList.add('show');
      btn.setAttribute('aria-expanded', 'true');
      // ZERO-LAG ON-DEMAND LOAD: Only load Google Translate script when user opens the language dropdown!
      ensureGoogleScriptLoaded();
      var searchInput = document.getElementById('flx-gt-search-input');
      if (searchInput && window.innerWidth > 768) {
        setTimeout(function() { searchInput.focus(); }, 40);
      }
    }
  };

  window.flxFilterGtLanguages = function(query) {
    var q = (query || '').toLowerCase().trim();
    var items = wrapper.querySelectorAll('#flx-gt-lang-grid .flx-gt-lang-item');
    for (var i = 0; i < items.length; i++) {
      var hay = items[i].getAttribute('data-lang-search') || '';
      items[i].style.display = (!q || hay.indexOf(q) !== -1) ? '' : 'none';
    }
  };

  window.flxSelectLanguage = function(targetLang, btnEl, e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    setGoogTransCookie(targetLang);
    updateSwitcherUI(targetLang);

    var menu = document.getElementById('flx-gt-dropdown-menu');
    var toggleBtn = document.getElementById('flx-gt-toggle-btn');
    if (menu) menu.classList.remove('show');
    if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');

    if (targetLang === sourceLang && !gtScriptLoaded) {
      return;
    }

    if (triggerGoogleCombo(targetLang)) {
      return;
    }

    // Show subtle spinner while on-demand script finishes initializing
    var caret = document.getElementById('flx-gt-caret-icon');
    if (caret) caret.className = 'fa-solid fa-spinner fa-spin flx-gt-caret';
    pendingTargetLang = targetLang;
    ensureGoogleScriptLoaded();

    // Fallback: if combo is already loaded in a frame or switching back to original
    setTimeout(function() {
      if (pendingTargetLang) {
        if (!triggerGoogleCombo(targetLang)) {
          window.location.reload();
        }
        pendingTargetLang = null;
      }
    }, 1800);
  };

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!e.target.closest('#flx-gt-wrapper')) {
      var menu = document.getElementById('flx-gt-dropdown-menu');
      var toggleBtn = document.getElementById('flx-gt-toggle-btn');
      if (menu && menu.classList.contains('show')) {
        menu.classList.remove('show');
        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      }
    }
  });

  // Check if visitor already has a non-default translation cookie active
  var currentSavedLang = getSavedGoogTransLang();
  if (currentSavedLang && currentSavedLang !== sourceLang) {
    updateSwitcherUI(currentSavedLang);
    if (autoRestore) {
      pendingTargetLang = currentSavedLang;
      var loadAfterIdle = function() {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(ensureGoogleScriptLoaded, { timeout: 1500 });
        } else {
          setTimeout(ensureGoogleScriptLoaded, 300);
        }
      };
      if (document.readyState === 'complete') {
        loadAfterIdle();
      } else {
        window.addEventListener('load', loadAfterIdle, { once: true });
      }
    }
  }
})();
</script>
