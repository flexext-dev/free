msgid "Save settings"
msgstr "Zapisz ustawienia"

#: flexext-darowizny-dla-przelewy24-lite.php:234
msgid "Success URL"
msgstr "Adres URL po udanej wpłacie (Success URL)"

#: flexext-darowizny-dla-przelewy24-lite.php:228
msgid "Description"
msgstr "Tytuł przelewu (opis transakcji)"

