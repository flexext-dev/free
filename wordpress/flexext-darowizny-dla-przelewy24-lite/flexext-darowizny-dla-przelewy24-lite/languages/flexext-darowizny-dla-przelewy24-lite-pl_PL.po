#: flexext-darowizny-dla-przelewy24-lite.php:415
msgid "Przelewy24 Secure"
msgstr "Bezpieczna płatność Przelewy24"

#. translators: %s: donation amount in PLN
#: flexext-darowizny-dla-przelewy24-lite.php:404
msgid "Donate %s PLN"
msgstr "Wpłać darowiznę %s PLN"

#: flexext-darowizny-dla-przelewy24-lite.php:400
msgid "Choose an amount or enter your own."
msgstr "Wybierz kwotę darowizny."

#: flexext-darowizny-dla-przelewy24-lite.php:376
msgid "Connection error. Please try again."
msgstr "Błąd połączenia. Spróbuj ponownie."

#: flexext-darowizny-dla-przelewy24-lite.php:375
msgid "Payment could not be started."
msgstr "Nie udało się rozpocząć płatności."

#: flexext-darowizny-dla-przelewy24-lite.php:342
msgid "Transaction registration failed."
msgstr "Rejestracja transakcji w Przelewy24 nie powiodła się."

#: flexext-darowizny-dla-przelewy24-lite.php:289
msgid "Invalid amount selection."
msgstr "Wybrano nieprawidłową kwotę darowizny."

#: flexext-darowizny-dla-przelewy24-lite.php:282
msgid "Missing Przelewy24 configuration. Complete all fields in FlexExt Lite settings."
msgstr "Brak pełnej konfiguracji Przelewy24. Uzupełnij wszystkie pola w ustawieniach FlexExt Lite."

#: flexext-darowizny-dla-przelewy24-lite.php:278
msgid "Widget is disabled."
msgstr "Widżet darowizn jest wyłączony."

